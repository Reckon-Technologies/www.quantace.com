{
  "name": "@workspace/auth",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsup src/*.ts --format esm --dts --out-dir dist",
    "dev:start": "tsc --watch"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@workspace/db": "workspace:*",
    "better-auth": "^1.3.34",
    "postmark": "^4.0.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "packageManager": "pnpm@10.4.1"
}
